<Application
    x:Class="MicPipe.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="SurfaceColor">#FF1A1C1E</Color>
      <Color x:Key="SurfaceAltColor">#FF242628</Color>
      <Color x:Key="AccentColor">#FFE0A045</Color>
      <Color x:Key="TextColor">#FFE8EAED</Color>
      <Color x:Key="MutedTextColor">#FF9AA0A6</Color>
      <Color x:Key="LiveColor">#FF3DDC84</Color>

      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
      <SolidColorBrush x:Key="LiveBrush" Color="{StaticResource LiveColor}" />

      <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,6" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
