<Window
    x:Class="MicPipe.Views.DevicesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Devices">

  <!-- Outer Grid only hosts the stylesheet; StaticResource can't see a dictionary declared on the same element. -->
  <Grid>
    <Grid.Resources>
      <ResourceDictionary Source="ms-appx:///Views/DevicesWindow.Styles.xaml" />
    </Grid.Resources>
  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,16,8">
      <StackPanel Spacing="12">
        <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="CableStatus" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />

        <ComboBox x:Name="MicCombo" Header="Microphone (your voice)" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name" SelectedValuePath="Id" />
        <ComboBox x:Name="CableCombo" Header="Virtual cable output (CABLE Input)" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name" SelectedValuePath="Id" />
        <ComboBox x:Name="MonitorCombo" Header="Hear clips on (headphones / speakers)" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name" SelectedValuePath="Id" />

        <HyperlinkButton Content="Get VB-Audio Virtual Cable" NavigateUri="https://vb-audio.com/Cable/" />

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Text="In Discord or your game, set the microphone input to CABLE Output (VB-Audio Virtual Cable). MicPipe mixes your real mic and clips into CABLE Input." />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="16,12"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button Content="Save &amp; start" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
