<Window
    x:Class="MicPipe.Views.DevicesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Devices">

  <Grid Background="{StaticResource SurfaceBrush}" Padding="16" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

    <TextBlock x:Name="CableStatus" Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />

    <ComboBox x:Name="MicCombo" Grid.Row="2" Header="Microphone (your voice)" HorizontalAlignment="Stretch"
              DisplayMemberPath="Name" SelectedValuePath="Id" />
    <ComboBox x:Name="CableCombo" Grid.Row="3" Header="Virtual cable output (CABLE Input)" HorizontalAlignment="Stretch"
              DisplayMemberPath="Name" SelectedValuePath="Id" />
    <ComboBox x:Name="MonitorCombo" Grid.Row="4" Header="Monitor (optional headphones)" HorizontalAlignment="Stretch"
              DisplayMemberPath="Name" SelectedValuePath="Id" />

    <HyperlinkButton Grid.Row="5" Content="Get VB-Audio Virtual Cable"
                     NavigateUri="https://vb-audio.com/Cable/" />

    <TextBlock Grid.Row="6" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
               Text="In Discord or your game, set the microphone input to CABLE Output (VB-Audio Virtual Cable). MicPipe mixes your real mic and clips into CABLE Input." />

    <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
      <Button Content="Refresh" Style="{StaticResource ToolButtonStyle}" Click="Refresh_Click" />
      <Button Content="Save &amp; start" Style="{StaticResource ToolButtonStyle}" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
