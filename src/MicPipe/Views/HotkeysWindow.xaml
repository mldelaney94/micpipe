<Window
    x:Class="MicPipe.Views.HotkeysWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hotkeys">

  <Grid Background="{StaticResource SurfaceBrush}" Padding="16" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Hotkeys" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
    <ScrollViewer Grid.Row="1">
      <StackPanel x:Name="BindingsPanel" Spacing="6" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
      <RadioButton x:Name="HoldRadio" Content="Hold to play" GroupName="Mode" />
      <RadioButton x:Name="ToggleRadio" Content="Press to play" GroupName="Mode" IsChecked="True" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button Content="Clear all" Style="{StaticResource ToolButtonStyle}" Click="Clear_Click" />
      <Button Content="Save" Style="{StaticResource ToolButtonStyle}" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
