<Window
    x:Class="MicPipe.Views.HotkeysWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hotkeys">

  <!-- Outer Grid only hosts the stylesheet; StaticResource can't see a dictionary declared on the same element. -->
  <Grid>
    <Grid.Resources>
      <ResourceDictionary Source="ms-appx:///Views/HotkeysWindow.Styles.xaml" />
    </Grid.Resources>
  <Grid Background="{StaticResource SurfaceBrush}" Padding="16" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Hotkeys" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

    <StackPanel Grid.Row="1" Spacing="4">
      <TextBlock Text="Active binds" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
      <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="10,8">
        <TextBlock x:Name="ActiveBindsText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel Spacing="8">
        <TextBlock Text="F1–F12" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
        <StackPanel x:Name="BindingsPanel" Spacing="6" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button Content="Clear all" Click="Clear_Click" />
      <Button Content="Save" Click="Save_Click" />
    </StackPanel>
  </Grid>
  </Grid>
</Window>
