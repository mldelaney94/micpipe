<Window
    x:Class="MicPipe.Views.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clips">

  <Grid Background="{StaticResource SurfaceBrush}" Padding="16" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Clips" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

    <ListView x:Name="ClipList" Grid.Row="1" SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnSpacing="12" Padding="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Grid.Column="2" Text="{Binding HotkeyText}" Foreground="{StaticResource AccentBrush}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Play" Style="{StaticResource ToolButtonStyle}" Click="Play_Click" />
      <Button Content="Stop" Style="{StaticResource ToolButtonStyle}" Click="Stop_Click" />
      <Button Content="Rename" Style="{StaticResource ToolButtonStyle}" Click="Rename_Click" />
      <Button Content="Delete" Style="{StaticResource ToolButtonStyle}" Click="Delete_Click" />
      <Button Content="Assign hotkey…" Style="{StaticResource ToolButtonStyle}" Click="Hotkey_Click" />
    </StackPanel>
  </Grid>
</Window>
