<Window
    x:Class="MicPipe.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MicPipe">

  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar: leave room on the right for caption (min/max/close) buttons -->
    <Grid x:Name="AppTitleBar"
          Grid.Row="0"
          Height="40"
          Padding="12,0,0,0"
          Background="{StaticResource SurfaceBrush}"
          ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="CaptionSpacer" Width="140" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="ms-appx:///Assets/MicPipe.png" Width="22" Height="22"
             Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="MicPipe" FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="LiveLabel" Text="Idle" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="16,8,16,8">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Devices" Style="{StaticResource ToolButtonStyle}" Click="Devices_Click" />
            <Button Content="Clips" Style="{StaticResource ToolButtonStyle}" Click="Clips_Click" />
            <Button x:Name="PttButton" Content="PTT: none" Style="{StaticResource ToolButtonStyle}" Click="Ptt_Click" />
          </StackPanel>
          <TextBlock x:Name="PttHint" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                     Text="Press a key to bind push-to-talk (Esc cancels)…" />

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mic pass-through" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70"
                    ValueChanged="MicVolume_Changed" />
            <TextBlock x:Name="MicVolumeLabel" Grid.Column="2" Text="70%" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Clip output" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Slider x:Name="ClipVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="85"
                    ValueChanged="ClipVolume_Changed" />
            <TextBlock x:Name="ClipVolumeLabel" Grid.Column="2" Text="85%" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <TextBlock x:Name="LastClipLabel" Text="Last: —" Foreground="{StaticResource TextBrush}" />
              <ProgressBar x:Name="PlayProgress"
                           Minimum="0" Maximum="1" Value="0" Height="6"
                           Foreground="{StaticResource AccentBrush}"
                           Background="{StaticResource SurfaceAltBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="1" Content="Stop" Style="{StaticResource ToolButtonStyle}" Click="Stop_Click"
                    VerticalAlignment="Top" />
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1"
              Background="{StaticResource SurfaceAltBrush}"
              Padding="16,12"
              BorderBrush="#33FFFFFF"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Import clip" Style="{StaticResource ToolButtonStyle}" Click="Import_Click" />
          <Button Content="Hotkeys" Style="{StaticResource ToolButtonStyle}" Click="Hotkeys_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
