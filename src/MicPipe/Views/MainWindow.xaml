<Window
    x:Class="MicPipe.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MicPipe">

  <Grid Background="{StaticResource SurfaceBrush}" Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Brand toolbar -->
    <Grid Grid.Row="0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="ms-appx:///Assets/MicPipe.png" Width="28" Height="28"
             Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="MicPipe" FontSize="22" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
        <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="LiveLabel" Text="Idle" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <Button Grid.Column="3" Content="Devices" Style="{StaticResource ToolButtonStyle}" Click="Devices_Click" />
      <Button Grid.Column="4" Content="Clips" Style="{StaticResource ToolButtonStyle}" Click="Clips_Click" Margin="8,0,0,0" />
      <Button Grid.Column="5" Content="Quit" Style="{StaticResource ToolButtonStyle}" Click="Quit_Click" Margin="8,0,0,0" />
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Mic pass-through" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
      <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70"
              ValueChanged="MicVolume_Changed" />
      <TextBlock x:Name="MicVolumeLabel" Grid.Column="2" Text="70%" Foreground="{StaticResource TextBrush}"
                 VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Clip output" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
      <Slider x:Name="ClipVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="85"
              ValueChanged="ClipVolume_Changed" />
      <TextBlock x:Name="ClipVolumeLabel" Grid.Column="2" Text="85%" Foreground="{StaticResource TextBrush}"
                 VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <Grid Grid.Row="3" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="LastClipLabel" Text="Last: —" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Stop" Style="{StaticResource ToolButtonStyle}" Click="Stop_Click" />
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
      <Button Content="Import clip" Style="{StaticResource ToolButtonStyle}" Click="Import_Click" />
      <Button Content="Hotkeys" Style="{StaticResource ToolButtonStyle}" Click="Hotkeys_Click" />
    </StackPanel>
  </Grid>
</Window>
