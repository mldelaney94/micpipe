<Window
    x:Class="MicPipe.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MicPipe">

  <!-- Outer Grid only hosts the stylesheet; StaticResource can't see a dictionary declared on the same element. -->
  <Grid>
    <Grid.Resources>
      <ResourceDictionary Source="ms-appx:///Views/MainWindow.Styles.xaml" />
    </Grid.Resources>
  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Custom title bar; CaptionSpacer is widened in code to clear the min/max/close buttons -->
    <Grid x:Name="AppTitleBar" Height="40" Padding="12,0,0,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="CaptionSpacer" Width="140" />
      </Grid.ColumnDefinitions>

      <Image Source="ms-appx:///Assets/MicPipe.png" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="MicPipe" FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="LiveLabel" Text="Idle" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,8,16,8">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Devices" Click="Devices_Click" />
          <Button Content="Clips" Click="Clips_Click" />
          <Button x:Name="PttButton" Content="PTT: none" Click="Ptt_Click" />
        </StackPanel>
        <TextBlock x:Name="PttHint" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                   Text="Press the key or mouse button your game uses for push-to-talk (Mouse4/5 work). Esc cancels, Backspace clears." />

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Mic pass-through" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="MicVolume_Changed" />
          <TextBlock x:Name="MicVolumeLabel" Grid.Column="2" Foreground="{StaticResource TextBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Clip output" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          <Slider x:Name="ClipVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="ClipVolume_Changed" />
          <TextBlock x:Name="ClipVolumeLabel" Grid.Column="2" Foreground="{StaticResource TextBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock x:Name="LastClipLabel" Text="Last: —" Foreground="{StaticResource TextBrush}" />
            <ProgressBar x:Name="PlayProgress" Minimum="0" Maximum="1" Height="6" Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceAltBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Stop" Click="Stop_Click" VerticalAlignment="Top" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="16,12"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Import clip" Click="Import_Click" />
        <Button Content="Hotkeys" Click="Hotkeys_Click" />
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
