<Window
    x:Class="MicPipe.Views.TrimWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Trim clip">

  <!-- Outer Grid only hosts the stylesheet; StaticResource can't see a dictionary declared on the same element. -->
  <Grid>
    <Grid.Resources>
      <ResourceDictionary Source="ms-appx:///Views/TrimWindow.Styles.xaml" />
    </Grid.Resources>
  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,16,8">
      <StackPanel Spacing="12">
        <TextBlock Text="Trim clip" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="SourceLabel" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />

        <!-- Bars are rebuilt on size change; the three overlays are repositioned per tick. Click/drag moves the nearer handle. -->
        <Border Background="{StaticResource SurfaceAltBrush}" Height="220" CornerRadius="4">
          <Canvas x:Name="WaveCanvas" PointerPressed="Wave_PointerPressed" PointerMoved="Wave_PointerMoved">
            <Canvas x:Name="WaveBars" />
            <Rectangle x:Name="SelectionBand" Fill="{StaticResource WaveSelectionBrush}" />
            <Rectangle x:Name="PlayedBand" Fill="{StaticResource WavePlayedBrush}" Visibility="Collapsed" />
            <Rectangle x:Name="Playhead" Width="2" Fill="{StaticResource WavePlayheadBrush}" Visibility="Collapsed" />
          </Canvas>
        </Border>

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StartLabel" Text="0:00.00" Foreground="{StaticResource TextBrush}" />
          <TextBlock x:Name="SelectionLabel" Grid.Column="1" Text="selection 0:00.00"
                     Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EndLabel" Grid.Column="2" Text="0:00.00" Foreground="{StaticResource TextBrush}"
                     HorizontalAlignment="Right" />
        </Grid>

        <Slider x:Name="StartSlider" Header="In" Minimum="0" Maximum="1000" Value="0" ValueChanged="Range_Changed" />
        <Slider x:Name="EndSlider" Header="Out" Minimum="0" Maximum="1000" Value="1000" ValueChanged="Range_Changed" />

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider x:Name="GainSlider" Header="Clip gain (baked into saved file)" Minimum="50" Maximum="300"
                  StepFrequency="5" Value="100" ValueChanged="Gain_Changed" />
          <TextBlock x:Name="GainLabel" Grid.Column="1" Text="100%" VerticalAlignment="Bottom"
                     Margin="0,0,0,8" MinWidth="48" Foreground="{StaticResource TextBrush}" />
        </Grid>
        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                   Text="Boost soft imports here (e.g. 150–200%). Gain is applied to previews and written into the saved WAV." />

        <TextBox x:Name="NameBox" Header="Name" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                   Text="Play selection previews on your speakers (or the Devices → Hear clips on device), never on the virtual cable." />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="16,12"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Play selection" Click="Preview_Click" />
        <Button Content="Stop" Click="Stop_Click" />
        <Button x:Name="SaveButton" Content="Save to library" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
