<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Trim window palette -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1A1C1E" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF242628" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FFE0A045" />
  <SolidColorBrush x:Key="TextBrush" Color="#FFE8EAED" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA0A6" />
  <SolidColorBrush x:Key="DividerBrush" Color="#33FFFFFF" />

  <!-- Waveform layers: bars, selection band, played band, playhead -->
  <SolidColorBrush x:Key="WaveBarBrush" Color="#FFE8EAED" />
  <SolidColorBrush x:Key="WaveSelectionBrush" Color="#28E0A045" />
  <SolidColorBrush x:Key="WavePlayedBrush" Color="#78E0A045" />
  <SolidColorBrush x:Key="WavePlayheadBrush" Color="#FFE0A045" />

  <!-- In/Out/gain sliders and the name box: WinUI paints these from the Windows accent colour, so restate them as orange. -->
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFE0A045" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFE0A045" Opacity="0.9" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE0A045" Opacity="0.8" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFE0A045" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFE0A045" Opacity="0.9" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFE0A045" Opacity="0.8" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FFE0A045" />
  <!-- Focus underline: both stops sit at offset 1.0 and the transform flips them, so only the bottom edge is accented. -->
  <LinearGradientBrush x:Key="TextControlBorderBrushFocused" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
    <LinearGradientBrush.RelativeTransform>
      <ScaleTransform ScaleY="-1" CenterY="0.5" />
    </LinearGradientBrush.RelativeTransform>
    <LinearGradientBrush.GradientStops>
      <GradientStop Offset="1.0" Color="#FFE0A045" />
      <GradientStop Offset="1.0" Color="#12FFFFFF" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>

  <!-- Flat buttons: one hover colour, one pressed colour, no border (overrides WinUI's lightweight-styling keys) -->
  <SolidColorBrush x:Key="ButtonBackground" Color="#FF242628" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF323538" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF3A3D40" />
  <SolidColorBrush x:Key="ButtonForeground" Color="#FFE8EAED" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFE8EAED" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFE8EAED" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
</ResourceDictionary>
